{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,99}$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 12000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "committed-policy",
              "owner-direction",
              "observed-assignment",
              "proposal"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://[^\\s]+$"
          },
          "revision": {
            "type": "string",
            "maxLength": 12000
          },
          "note": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "revision",
          "note"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent",
              "human",
              "subagent"
            ]
          },
          "responsibilities": {
            "type": "string",
            "maxLength": 12000
          },
          "authority": {
            "type": "string",
            "maxLength": 12000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          },
          "runtime": {
            "type": "object",
            "properties": {
              "backends": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "maxItems": 2,
                "uniqueItems": true
              },
              "location": {
                "type": "string",
                "enum": [
                  "any",
                  "local",
                  "remote"
                ]
              }
            },
            "required": [
              "backends",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "responsibilities",
          "authority",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "when": {
            "type": "string",
            "maxLength": 2000
          },
          "artifact": {
            "type": "string",
            "maxLength": 2000
          },
          "guard": {
            "type": "string",
            "maxLength": 2000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "action",
          "when",
          "artifact",
          "guard",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          },
          "issueState": {
            "type": "string",
            "enum": [
              "any",
              "opened",
              "closed"
            ]
          },
          "labelsAny": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "labelPrefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "fallback": {
            "type": "boolean"
          },
          "acceptsDelivery": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "roles",
          "issueState",
          "labelsAny",
          "labelPrefixes",
          "fallback"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "guard": {
            "type": "string",
            "maxLength": 12000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "role",
          "action",
          "guard",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "maxLength": 60000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "roles",
          "text",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "condition",
              "timer",
              "idle"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "condition": {
            "type": "string",
            "enum": [
              "turn-completed",
              "idle",
              "attention",
              "closed"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "mode": {
            "type": "string",
            "enum": [
              "automatic",
              "review"
            ]
          },
          "handoff": {
            "type": "string",
            "maxLength": 100
          },
          "contract": {
            "type": "string",
            "pattern": "(?:[0-9a-f]{64}|stale)?",
            "maxLength": 64
          },
          "recipientMode": {
            "type": "string",
            "enum": [
              "single",
              "all"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "source",
          "target",
          "event",
          "condition",
          "minutes",
          "message",
          "mode",
          "handoff",
          "contract"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$",
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "maxLength": 12000
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          },
          "blocking": {
            "type": "boolean"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "open",
              "accepted"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,99}$",
              "maxLength": 100
            },
            "maxItems": 300,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "summary",
          "roles",
          "blocking",
          "resolution",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "sources",
    "roles",
    "handoffs",
    "states",
    "transitions",
    "policies",
    "triggers",
    "gaps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet Studio workflow v1"
}
